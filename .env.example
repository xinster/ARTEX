# Docker 部署配置（复制为 .env：cp .env.example .env）

# ── 数据库 ──────────────────────────────────────────────────────
# 必填。docker-compose.yml 会以此校验，保留默认值会直接拒绝启动。
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ── 镜像来源 ────────────────────────────────────────────────────
# 上游 Docker Hub 镜像仓库 autumn27/artex 已被删除，compose 默认改为**本地构建**，
# 不再拉外部镜像。要用自己推到 registry 的镜像时取消下面一行的注释：
# ARTEX_IMAGE=myregistry.example.com/artex:0.3.15
#
# 本地构建请走 ./docker-build.sh（它先编译 dist/<arch>/artex 再 build 镜像；
# 直接 `docker compose up -d --build` 会因缺少预编译二进制而在 COPY 处失败）。
# ARTEX_TARGETARCH=arm64
# ARTEX_PULL_POLICY=never

# ── LLM（二选一或都填；也可留空到页面「系统配置 → LLM 配置」里配）──────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=